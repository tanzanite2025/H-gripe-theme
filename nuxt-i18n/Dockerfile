FROM node:24-alpine AS build
WORKDIR /app
# The default IPX provider creates responsive derivatives at request time.
# Source uploads are never rewritten.
COPY package*.json ./
RUN npm ci
COPY . .
ARG NUXT_PUBLIC_API_BASE=/api/v1
ARG NUXT_PUBLIC_SITE_URL=
ARG NUXT_IMAGE_DOMAINS=
ARG NUXT_IMAGE_INTERNAL_ORIGIN=http://web:8080
ARG NUXT_IMAGE_MAX_INPUT_PIXELS=24000000
ARG NUXT_IMAGE_OPTIMIZE_UPLOADS=false
ARG NITRO_PRESET=node-server
ARG API_INTERNAL_ORIGIN=http://api:9000
ARG CDN_URL=
ARG NUXT_IMAGE_PROVIDER=ipx
ENV NUXT_PUBLIC_API_BASE=${NUXT_PUBLIC_API_BASE}
ENV NUXT_PUBLIC_SITE_URL=${NUXT_PUBLIC_SITE_URL}
ENV NUXT_IMAGE_DOMAINS=${NUXT_IMAGE_DOMAINS}
ENV NUXT_IMAGE_INTERNAL_ORIGIN=${NUXT_IMAGE_INTERNAL_ORIGIN}
ENV NUXT_IMAGE_MAX_INPUT_PIXELS=${NUXT_IMAGE_MAX_INPUT_PIXELS}
ENV NUXT_IMAGE_OPTIMIZE_UPLOADS=${NUXT_IMAGE_OPTIMIZE_UPLOADS}
ENV NUXT_PUBLIC_IMAGE_UPLOAD_OPTIMIZATION_ENABLED=${NUXT_IMAGE_OPTIMIZE_UPLOADS}
ENV NITRO_PRESET=${NITRO_PRESET}
ENV API_INTERNAL_ORIGIN=${API_INTERNAL_ORIGIN}
ENV CDN_URL=${CDN_URL}
ENV NUXT_IMAGE_PROVIDER=${NUXT_IMAGE_PROVIDER}
RUN npm run build

FROM node:24-alpine
WORKDIR /app
COPY --from=build /app/.output ./.output
RUN find .output -type f -name '*.map' -delete \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
ENV NODE_OPTIONS="--max-old-space-size=768 --disable-warning=DEP0155"
ENV NUXT_PUBLIC_API_BASE=/api/v1
ARG NUXT_IMAGE_INTERNAL_ORIGIN=http://web:8080
ENV NUXT_IMAGE_INTERNAL_ORIGIN=${NUXT_IMAGE_INTERNAL_ORIGIN}
ENV NUXT_IMAGE_OPTIMIZE_UPLOADS=false
ENV NUXT_PUBLIC_IMAGE_UPLOAD_OPTIMIZATION_ENABLED=false
ENV UV_THREADPOOL_SIZE=2
ENV STOREFRONT_IMAGE_SHARP_CACHE_MEMORY_MB=16
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
  CMD wget -q --spider http://127.0.0.1:3000/_internal/image-health || exit 1
CMD ["node", ".output/server/index.mjs"]
