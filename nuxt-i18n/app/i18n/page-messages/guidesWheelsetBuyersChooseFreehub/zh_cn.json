{
  "intro": {
    "title": "选择塔基",
    "body": "这是一份用于匹配塔基与传动系统飞轮的综合指南（Shimano、SRAM、Campagnolo）。"
  },
  "ecosystems": {
    "shimano": {
      "title": "Shimano 生态",
      "cards": {
        "microSpline": {
          "caption": "适用于山地 12 速",
          "name": "Micro Spline（MS）",
          "body": "Deore M6100、XT M8100、XTR M9100"
        },
        "hgRoad": {
          "caption": "适用于公路 11/12 速",
          "name": "公路 HG（HG-11）",
          "body": "105、Ultegra、Dura-Ace（8-12 速）"
        },
        "hgMountain": {
          "caption": "适用于山地 8-11 速",
          "name": "山地 HG",
          "body": "旧款山地车和入门级公路车配置"
        }
      },
      "cheatsheetTitle": "兼容性速查",
      "cheatsheet": {
        "microSpline": "MS（Micro Spline）：Shimano 12 速山地飞轮必须使用，起始齿片为 10T；不向下兼容。",
        "hyperglide": "HG（HyperGlide）：沿用多年的主流标准，适用于 8-11 速山地和 8-12 速公路飞轮。注意：公路 11 速 HG 塔基更长，安装山地飞轮时需要 1.85mm 垫圈。"
      }
    },
    "sram": {
      "title": "SRAM 生态",
      "cards": {
        "xd": {
          "caption": "适用于山地 11/12 速",
          "name": "XD 塔基",
          "body": "GX Eagle、X01、XX1（起始齿片 10T）"
        },
        "xdr": {
          "caption": "适用于公路 12 速",
          "name": "XDR 塔基",
          "body": "Rival、Force、Red eTap AXS"
        }
      },
      "cheatsheetTitle": "兼容性速查",
      "cheatsheet": {
        "xd": "XD：适用于最小齿片为 10T 的山地飞轮，结构紧凑。",
        "xdr": "XDR：XD 的公路版本，比 XD 长 1.85mm。加装 1.85mm 垫圈后可安装 XD 飞轮，主要用于 12 速 AXS 公路套件。"
      }
    },
    "campagnolo": {
      "title": "Campagnolo 生态",
      "cards": {
        "n3w": {
          "caption": "适用于 13 速 / Gravel",
          "name": "N3W",
          "body": "Ekar 13 速（加转接环后向下兼容）"
        },
        "classic": {
          "caption": "经典公路",
          "name": "Classic（ED/CP）",
          "body": "9/10/11/12 速公路"
        }
      },
      "cheatsheetTitle": "兼容性速查",
      "cheatsheet": {
        "n3w": "N3W：面向未来的标准，原生适用于 Ekar 13 速；加转接环后可安装旧款 10-12 速飞轮。",
        "classic": "Classic：适用于 Super Record、Record、Chorus（11/12 速）的传统花键标准。"
      }
    }
  },
