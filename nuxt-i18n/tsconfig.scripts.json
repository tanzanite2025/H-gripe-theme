{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "~": ["./app"],
      "~/*": ["./app/*"],
      "@": ["./app"],
      "@/*": ["./app/*"]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts/*.ts",
    "scripts/**/*.d.ts",
    "scripts/i18n/**/*.ts",
    "scripts/seo/check-sitemap-xml.ts",
    "scripts/seo/check-drivetrain-geo.ts",
    "scripts/storefront/**/*.ts",
    "tailwind.config.ts"
  ]
}
