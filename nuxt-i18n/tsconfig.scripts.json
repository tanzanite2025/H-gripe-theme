{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts/*.ts",
    "scripts/**/*.d.ts",
    "scripts/i18n/**/*.ts",
    "scripts/storefront/**/*.ts",
    "tailwind.config.ts",
    "convert-font.ts"
  ]
}
