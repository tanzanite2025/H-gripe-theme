{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "~~": ["."],
      "~~/*": ["./*"],
      "~": ["./app"],
      "~/*": ["./app/*"],
      "@": ["./app"],
      "@/*": ["./app/*"]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "config/storefront/public-client-entry-javascript-dependency-boundary-plugin.ts",
    "scripts/*.ts",
    "scripts/**/*.d.ts",
    "scripts/i18n/**/*.ts",
    "scripts/seo/check-sitemap-xml.ts",
    "scripts/seo/check-bicycle-inner-tube-guide-multilingual-indexing-and-sitemap-consistency.ts",
    "scripts/seo/check-bicycle-inner-tube-guide-content-and-structured-data-server-rendering.ts",
    "scripts/seo/check-drivetrain-geo.ts",
    "scripts/storefront/**/*.ts",
    "tailwind.config.ts"
  ]
}
