# Database Configuration
DB_HOST=localhost
DB_PORT=9400
DB_USERNAME=commerce_platform
DB_PASSWORD=commerce_platform_password
DB_NAME=commerce_platform
DB_SSLMODE=disable
DB_LOG_LEVEL=silent

# JWT Secret
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRATION=24h

# Operations connector credential encryption.
# Keep this backend-only key stable after connector credentials are saved.
OPS_CONNECTOR_MASTER_KEY=

# Operations provider browser authorization.
# Cloudflare OAuth client must be created in the Cloudflare dashboard and its
# redirect URL must exactly match the callback URL below.
OPS_CONNECTOR_OAUTH_REDIRECT_URL=http://localhost:9200/api/admin/ops/connectors/oauth/callback
OPS_CONNECTOR_OAUTH_POST_CONNECT_URL=http://localhost:9300/ops/connectors
OPS_CLOUDFLARE_OAUTH_CLIENT_ID=
OPS_CLOUDFLARE_OAUTH_CLIENT_SECRET=
# Optional: space-separated scopes copied from the Cloudflare OAuth client.
# Leave blank to use the scopes configured on that client.
OPS_CLOUDFLARE_OAUTH_SCOPES=
# GitHub OAuth App. Register the callback URL above exactly in GitHub.
OPS_GITHUB_OAUTH_CLIENT_ID=
OPS_GITHUB_OAUTH_CLIENT_SECRET=
# Default: read:user user:email repo read:packages
OPS_GITHUB_OAUTH_SCOPES=read:user user:email repo read:packages

# Restricted production rollback executor.
# Disabled unless all SSH values are explicitly configured. The host must match
# the bound VPS hostname or IP, and known_hosts must contain the exact host key.
OPS_DEPLOY_ROLLBACK_ENABLED=false
OPS_DEPLOY_ROLLBACK_SSH_HOST=
OPS_DEPLOY_ROLLBACK_SSH_PORT=22
OPS_DEPLOY_ROLLBACK_SSH_USER=
OPS_DEPLOY_ROLLBACK_SSH_PRIVATE_KEY_PATH=
OPS_DEPLOY_ROLLBACK_SSH_KNOWN_HOSTS_PATH=
OPS_DEPLOY_ROLLBACK_SSH_WORKDIR=/srv/commerce-platform
OPS_DEPLOY_ROLLBACK_SSH_TIMEOUT_SECONDS=900

# Google Merchant Center channel connection.
# The redirect URI must exactly match the URI registered in Google Cloud.
GOOGLE_MERCHANT_CLIENT_ID=
GOOGLE_MERCHANT_CLIENT_SECRET=
GOOGLE_MERCHANT_REDIRECT_URL=http://localhost:9200/api/admin/google-merchant/oauth/callback
GOOGLE_MERCHANT_POST_CONNECT_URL=http://localhost:9300/google-merchant
# Use a dedicated production secret. Never expose this key to the frontend.
GOOGLE_MERCHANT_TOKEN_ENCRYPTION_KEY=
GOOGLE_MERCHANT_STATE_TTL_SECONDS=600

# Server Configuration
SERVER_PORT=:9200
SERVER_MODE=debug
SERVER_HOST=localhost
SERVER_BASE_URL=http://localhost:9200
SERVER_READ_TIMEOUT=60
SERVER_READ_HEADER_TIMEOUT=10
SERVER_WRITE_TIMEOUT=60
SERVER_IDLE_TIMEOUT=120
SERVER_MAX_HEADER_BYTES=1048576
# Public storefront origin used for Google Merchant product links and relative media URLs.
# Use a real HTTPS domain before submitting offers to Google Merchant Center.
STOREFRONT_BASE_URL=http://localhost:9199
# Internal storefront origin used by backend checks for /_internal/* endpoints.
# Use http://frontend:3000 when the backend runs in docker-compose.
STOREFRONT_INTERNAL_ORIGIN=http://localhost:9199
TRUSTED_PROXIES=

# Redis Configuration
REDIS_MODE=standalone
REDIS_HOST=localhost
REDIS_PORT=9510
REDIS_ADDRS=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
# Sentinel/failover mode:
# REDIS_MODE=sentinel
# REDIS_ADDRS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
# REDIS_MASTER_NAME=mymaster
# REDIS_SENTINEL_USERNAME=
# REDIS_SENTINEL_PASSWORD=

# Customer-service durable cross-instance relay. Local development can keep
# these disabled. Production must set both CUSTOMER_SERVICE_REALTIME_ENABLED
# and WORKER_OUTBOX_DISPATCH_ENABLED to true against the same Redis deployment.
CUSTOMER_SERVICE_REALTIME_ENABLED=false
CUSTOMER_SERVICE_REALTIME_STREAM=customer_service:{realtime}:v1
CUSTOMER_SERVICE_REALTIME_STREAM_MAX_LEN=10000
CUSTOMER_SERVICE_REALTIME_REPLAY_LIMIT=200
CUSTOMER_SERVICE_REALTIME_CONSUMER_BLOCK_SECONDS=5
CUSTOMER_SERVICE_REALTIME_DEDUP_RETENTION_SECONDS=86400

# Product cache: Redis-backed cross-instance stampede protection.
# Keep this shorter than the product cache TTL and large enough for a DB load.
CACHE_PRODUCT_TTL=1800
CACHE_PRODUCT_LOCK_TTL=5

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:9100,http://127.0.0.1:9100,http://localhost:9300,http://127.0.0.1:9300,http://localhost:9200,http://127.0.0.1:9200

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Commerce Platform

# File Storage Configuration
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_BASE_URL=http://localhost:9200
# For S3/OSS
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=

# Dedicated site logo storage. Leave unset to use the sibling site-logo-uploads
# directory for local storage; S3/OSS deployments may provide a separate bucket.
SITE_LOGO_STORAGE_TYPE=local
SITE_LOGO_STORAGE_LOCAL_PATH=./site-logo-uploads
SITE_LOGO_STORAGE_BASE_URL=http://localhost:9200
SITE_LOGO_STORAGE_BUCKET=
SITE_LOGO_STORAGE_REGION=
SITE_LOGO_STORAGE_ACCESS_KEY_ID=
SITE_LOGO_STORAGE_SECRET_ACCESS_KEY=
SITE_LOGO_STORAGE_ENDPOINT=

# Cumulative media storage quota for each authenticated admin uploader.
MEDIA_UPLOAD_ACCOUNT_STORAGE_QUOTA_BYTES=21474836480

# Picture Warehouse upload protection. These limits are enforced inside the API,
# independent of edge/WAF protection.
SHOWCASE_UPLOAD_PROTECTION_ENABLED=true
SHOWCASE_UPLOAD_WINDOW_SECONDS=60
SHOWCASE_UPLOAD_MAX_UPLOADS_PER_USER=3
SHOWCASE_UPLOAD_MAX_UPLOADS_PER_IP=6
SHOWCASE_UPLOAD_MAX_UPLOADS_PER_IP_PREFIX=18
SHOWCASE_UPLOAD_DAILY_MAX_UPLOADS_PER_USER=12
SHOWCASE_UPLOAD_DAILY_MAX_UPLOADS_PER_IP=24
SHOWCASE_UPLOAD_DAILY_MAX_BYTES_PER_USER=104857600
SHOWCASE_UPLOAD_DAILY_MAX_BYTES_PER_IP=209715200
SHOWCASE_UPLOAD_MAX_PENDING_SUBMISSIONS_PER_USER=10
SHOWCASE_UPLOAD_FAILURE_WINDOW_SECONDS=900
SHOWCASE_UPLOAD_MAX_FAILURES_PER_USER=5
SHOWCASE_UPLOAD_MAX_FAILURES_PER_IP=10
SHOWCASE_UPLOAD_BLOCK_DURATION_SECONDS=1800

# Quick Buy API token bucket protection. Enforced in the Go API with Redis;
# Ops project policy records the desired edge/backend limits.
QUICK_BUY_RATE_LIMIT_ENABLED=true
QUICK_BUY_RATE_LIMIT_IP_REQUESTS_PER_MINUTE=120
QUICK_BUY_RATE_LIMIT_IP_BURST=40
QUICK_BUY_RATE_LIMIT_SESSION_REQUESTS_PER_MINUTE=60
QUICK_BUY_RATE_LIMIT_SESSION_BURST=20
QUICK_BUY_RATE_LIMIT_FAIL_OPEN=true

# Public feedback token bucket protection. Redis enforces the cross-instance
# limit; when Redis is down the API falls back to a local in-process limiter.
FEEDBACK_RATE_LIMIT_ENABLED=true
FEEDBACK_RATE_LIMIT_READ_IP_REQUESTS_PER_MINUTE=120
FEEDBACK_RATE_LIMIT_READ_IP_BURST=40
FEEDBACK_RATE_LIMIT_WRITE_IP_REQUESTS_PER_MINUTE=12
FEEDBACK_RATE_LIMIT_WRITE_IP_BURST=4
FEEDBACK_RATE_LIMIT_WRITE_USER_REQUESTS_PER_MINUTE=6
FEEDBACK_RATE_LIMIT_WRITE_USER_BURST=2
FEEDBACK_RATE_LIMIT_FAIL_OPEN=false

# Payment Gateway Configuration
# Generate once with: openssl rand -hex 32
# Keep this value in the backend environment only. Do not rotate it after
# encrypted admin payment credentials have been saved unless you are doing
# an explicit credential re-encryption migration.
PAYMENT_CONFIG_MASTER_KEY=
# Stripe
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_ENVIRONMENT=sandbox

# PayPal
PAYPAL_API_KEY=your_paypal_client_id
PAYPAL_SECRET_KEY=your_paypal_secret
PAYPAL_WEBHOOK_SECRET=your_webhook_id
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_WEBHOOK_ID=your_webhook_id
PAYPAL_ENVIRONMENT=sandbox
# Optional PayPal dispute commercial invoice PDF attachment.
# Seller name and address are required before an invoice PDF can be generated.
# STORAGE_BASE_URL must resolve to a public HTTPS URL that PayPal can fetch.
PAYPAL_DISPUTE_AUTO_ATTACH_INVOICE_PDF=true
PAYPAL_DISPUTE_INVOICE_SELLER_NAME=
PAYPAL_DISPUTE_INVOICE_SELLER_ADDRESS=
PAYPAL_DISPUTE_INVOICE_SELLER_EMAIL=
PAYPAL_DISPUTE_INVOICE_SELLER_PHONE=
PAYPAL_DISPUTE_INVOICE_SELLER_WEBSITE=
PAYPAL_DISPUTE_INVOICE_SELLER_TAX_ID=

# Alipay
ALIPAY_API_KEY=your_alipay_app_id
ALIPAY_SECRET_KEY=your_alipay_private_key
ALIPAY_WEBHOOK_SECRET=your_alipay_public_key
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_alipay_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key
ALIPAY_ENVIRONMENT=sandbox

# WeChat Pay
WECHAT_MCH_ID=your_wechat_mch_id
WECHAT_PRIVATE_KEY_PATH=./certs/wechatpay/apiclient_key.pem
WECHAT_MERCHANT_SERIAL=your_wechat_merchant_certificate_serial
WECHAT_API_V3_KEY=your_32_character_wechat_api_v3_key
WECHAT_PAY_PLATFORM_CERTIFICATE=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=
WECHAT_ENVIRONMENT=sandbox

# Tracking Service Configuration (17TRACK)
TRACKING_PROVIDER=17track
TRACKING_API_KEY=your_17track_api_key
TRACKING_BASE_URL=https://api.17track.net/track/v2

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_DURATION=1m

# Background cleanup and compact visitor risk aggregation
WORKER_VISITOR_PROFILE_CLEANUP_ENABLED=false
WORKER_VISITOR_PROFILE_CLEANUP_INTERVAL_SECONDS=86400
WORKER_BEHAVIOR_EVENT_CLEANUP_ENABLED=false
WORKER_BEHAVIOR_EVENT_CLEANUP_INTERVAL_SECONDS=86400
WORKER_OUTBOX_DISPATCH_ENABLED=false
WORKER_OUTBOX_DISPATCH_INTERVAL_SECONDS=10
WORKER_OUTBOX_DISPATCH_BATCH_LIMIT=100
WORKER_OUTBOX_DISPATCH_LOCK_TIMEOUT_SECONDS=300
WORKER_PAYMENT_EXPIRATION_ENABLED=false
WORKER_PAYMENT_EXPIRATION_INTERVAL_SECONDS=900
WORKER_PAYMENT_PENDING_TTL_SECONDS=1800
WORKER_PAYMENT_EXPIRATION_BATCH_LIMIT=100
WORKER_SITE_QUALITY_ENABLED=false
WORKER_SITE_QUALITY_DISPATCH_INTERVAL_SECONDS=30
WORKER_SITE_QUALITY_BATCH_LIMIT=1
WORKER_SITE_QUALITY_LEASE_TIMEOUT_SECONDS=900
WORKER_SITE_QUALITY_SAMPLE_COUNT=3
WORKER_SITE_QUALITY_CONFIRMATIONS=2
WORKER_SITE_QUALITY_CLEAN_EVALUATIONS=2
WORKER_SITE_QUALITY_PROVIDER_CONCURRENCY=1
WORKER_SITE_QUALITY_PROVIDER_SPACING_SECONDS=5
WORKER_MEDIA_DERIVATIVE_REBUILD_ENABLED=true
WORKER_MEDIA_DERIVATIVE_REBUILD_INTERVAL_SECONDS=5
WORKER_MEDIA_DERIVATIVE_REBUILD_BATCH_LIMIT=10
WORKER_SHOWCASE_CLEANUP_ENABLED=true
WORKER_SHOWCASE_CLEANUP_INTERVAL_SECONDS=86400
WORKER_SHOWCASE_PENDING_TTL_SECONDS=2592000
WORKER_SHOWCASE_CLEANUP_BATCH_LIMIT=100
WORKER_HOT_DATA_ARCHIVE_ENABLED=false
WORKER_HOT_DATA_ARCHIVE_INTERVAL_SECONDS=86400
WORKER_HOT_DATA_ARCHIVE_BATCH_LIMIT=500
ORDER_PAID_OUTBOX_WEBHOOK_URL=
ORDER_PAID_OUTBOX_WEBHOOK_TOKEN=
VERIFIED_CONVERSION_OUTBOX_WEBHOOK_URL=
VERIFIED_CONVERSION_OUTBOX_WEBHOOK_TOKEN=
BEHAVIOR_EVENTS_LOW_INTENT_RETENTION_DAYS=30
BEHAVIOR_EVENTS_STANDARD_INTENT_RETENTION_DAYS=60
BEHAVIOR_EVENTS_HIGH_INTENT_RETENTION_DAYS=180
BEHAVIOR_EVENTS_CLEANUP_BATCH_LIMIT=5000
VISITOR_RISK_ENABLED=false
VISITOR_RISK_HASH_SALT=
VISITOR_RISK_FLUSH_INTERVAL_SECONDS=60
VISITOR_RISK_MAX_PENDING_FACTS=5000
VISITOR_RISK_SAMPLE_PATH_LIMIT=8
VISITOR_RISK_RETENTION_DAYS=365
ORDER_ABUSE_ENABLED=false
ORDER_ABUSE_ORDER_CREATE_WINDOW_SECONDS=600
ORDER_ABUSE_MAX_ORDER_CREATIONS_PER_USER=3
ORDER_ABUSE_MAX_ORDER_CREATIONS_PER_SESSION=3
ORDER_ABUSE_MAX_ORDER_CREATIONS_PER_IP=12
# Public order numbers use a snowflake source plus keyed HMAC obfuscation.
# Set a dedicated production secret; blank falls back to JWT_SECRET for local development.
ORDER_NUMBER_SECRET=
# Set only during a key rotation so historical order numbers remain verifiable.
# Remove it only after old-key orders no longer need self-service lookup.
ORDER_NUMBER_PREVIOUS_SECRET=
# Set a distinct node id (0-1023) for every API instance when scaling horizontally.
ORDER_NUMBER_NODE_ID=0
# Payment-risk snapshots remain local unless alerts are explicitly enabled and
# an authenticated Outbox receiver is configured.
PAYMENT_RISK_MONITORING_ALERT_ENABLED=false
PAYMENT_RISK_ALERT_OUTBOX_WEBHOOK_URL=
PAYMENT_RISK_ALERT_OUTBOX_WEBHOOK_TOKEN=
PAYMENT_BIN_RATE_LIMIT_ENABLED=true
PAYMENT_BIN_RATE_LIMIT_WINDOW_SECONDS=60
PAYMENT_BIN_RATE_LIMIT_FAILURE_THRESHOLD=5
PAYMENT_BIN_RATE_LIMIT_BLOCK_DURATION_SECONDS=1800
PAYMENT_GATEWAY_CIRCUIT_BREAKER_ENABLED=true
PAYMENT_GATEWAY_CIRCUIT_BREAKER_WINDOW_SECONDS=60
PAYMENT_GATEWAY_CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=0.15
PAYMENT_GATEWAY_CIRCUIT_BREAKER_MINIMUM_SAMPLE_COUNT=20
PAYMENT_GATEWAY_CIRCUIT_BREAKER_OPEN_DURATION_SECONDS=30
# Must cover PayPal token acquisition plus payment creation. During this
# period exactly one API replica owns the half-open payment probe.
PAYMENT_GATEWAY_CIRCUIT_BREAKER_HALF_OPEN_PROBE_TIMEOUT_SECONDS=60

# Redis-backed, cross-replica resilience for Outbox webhooks, tracking, and
# Google Merchant calls. The half-open probe timeout must exceed their
# respective HTTP request timeouts.
OUTBOUND_HTTP_RESILIENCE_ENABLED=true
OUTBOUND_HTTP_RESILIENCE_RETRY_MAX_ATTEMPTS=3
OUTBOUND_HTTP_RESILIENCE_RETRY_BASE_DELAY_MILLIS=250
OUTBOUND_HTTP_RESILIENCE_RETRY_MAX_DELAY_MILLIS=3000
OUTBOUND_HTTP_RESILIENCE_RETRY_JITTER_MILLIS=250
OUTBOUND_HTTP_RESILIENCE_FAILURE_THRESHOLD=4
OUTBOUND_HTTP_RESILIENCE_FAILURE_WINDOW_SECONDS=60
OUTBOUND_HTTP_RESILIENCE_OPEN_DURATION_SECONDS=30
OUTBOUND_HTTP_RESILIENCE_HALF_OPEN_PROBE_TIMEOUT_SECONDS=30

PAYMENT_PROTECTION_ENABLED=true
PAYMENT_PROTECTION_MAX_CONTROL_DURATION_HOURS=168
PAYMENT_PROTECTION_MAX_PAUSE_PAYMENT_DURATION_HOURS=24
PAYMENT_PROTECTION_MAX_GLOBAL_PAUSE_PAYMENT_DURATION_HOURS=2
PAYMENT_3DS_ADAPTIVE_ENABLED=true
PAYMENT_3DS_LOW_RISK_MAX_AMOUNT=100.0
PAYMENT_3DS_TRUSTED_PAID_ORDERS=1
PAYMENT_3DS_VISITOR_RISK_LOOKBACK_DAYS=30
PAYMENT_3DS_STEP_UP_RISK_SCORE=20
PAYMENT_3DS_CHALLENGE_RISK_SCORE=60

# Internal-only Lighthouse runner. This is deployment wiring, not an
# operator-managed API integration.
SITE_QUALITY_RUNNER_URL=http://localhost:9240
SITE_QUALITY_RUNNER_TOKEN=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# i18n
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,fr,de,es,ja,ko,it,pt,ru,ar,fi,da,th,sv,id,ms,be,tr,bn,fa,nl,hi,ur,mr,pcm,fil,te,ha,ps,sw,tl,ta,jv,zh_cn

# Optional storefront content release webhook.
# Use this only when a deployment platform or CI pipeline must rebuild after
# FAQ content changes. HTML cache purge remains the normal runtime path.
STOREFRONT_CONTENT_RELEASE_WEBHOOK_URL=
STOREFRONT_CONTENT_RELEASE_WEBHOOK_TOKEN=
STOREFRONT_CONTENT_RELEASE_DEBOUNCE_MS=1000
