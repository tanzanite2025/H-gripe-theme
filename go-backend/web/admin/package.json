{
  "name": "admin-panel",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 9300 --strictPort",
    "build": "npm run check:admin-font-policy && vite build && npm run check:admin-font-policy -- --dist",
    "preview": "vite preview",
    "test": "vitest run --environment node",
    "check:storefront-locale-ui": "node scripts/check-storefront-locale-ui.ts",
    "check:admin-font-policy": "node scripts/check-admin-font-policy.ts",
    "typecheck": "npm run check:admin-font-policy && npm run check:storefront-locale-ui && vue-tsc --noEmit"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@lucide/vue": "^1.25.0",
    "@tanstack/vue-table": "^8.21.3",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-region-data": "^4.1.0",
    "echarts": "^6.1.0",
    "imagetracerjs": "^1.2.6",
    "pinia": "^2.1.7",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.4.0",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.2.5",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.9"
  }
}
